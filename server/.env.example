# Server Configuration
# Local: PORT=8000, CLIENT_URL=http://localhost:3000
# Production: PORT is often set by the host (Render/Railway). Set CLIENT_URL to the live frontend origin.
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/code_lens

# Better Auth
# Production: BETTER_AUTH_URL must be the public API origin (https://your-api.example.com)
# GitHub OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars
BETTER_AUTH_URL=http://localhost:8000

# GitHub OAuth App (for User Sign-In)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub App (for Webhooks, Repo Access & PR Reviews)
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_APP_SLUG=your-github-app-slug

# AI Model Provider (OpenRouter / Gemini) — at least one is required for reviews
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key

# Pinecone Vector Store (for Codebase RAG)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=code-lens-index

# Razorpay Billing (Pro Plan Subscriptions)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PRO_PLAN_ID=plan_your_pro_plan_id
