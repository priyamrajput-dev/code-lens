# =============================================================================
# CodeLens client (Vite) environment
# Copy to `.env` for local, or set these in your host (Vercel / Netlify / etc.)
# Vite only exposes variables prefixed with VITE_ and inlines them at build time.
# =============================================================================

# Backend API origin (no trailing slash).
# Local:        http://localhost:8000
# Same-origin:  leave empty if Express serves client/dist
# Split deploy: https://your-api.example.com
VITE_SERVER_URL=http://localhost:8000

# Razorpay Key ID shown in checkout (public). Use rzp_live_ in production.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
