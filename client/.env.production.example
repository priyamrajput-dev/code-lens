# Copy to `.env.production` before `vite build`, or set these in the host dashboard.
# Vite uses .env.production automatically when MODE=production.

# Public API URL of the deployed server (no trailing slash).
# If the Express server serves client/dist on the same domain, leave this empty.
VITE_SERVER_URL=https://your-api.example.com

# Live Razorpay public key
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
